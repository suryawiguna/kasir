{
  "name": "kasir-base",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:test": "VITE_USE_EMULATOR=true vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit && tsc --noEmit -p worker && node scripts/check-paths.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "npx --yes firebase-tools@15 emulators:exec --only firestore --project demo-kasir \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "npx --yes firebase-tools@15 emulators:start --only firestore,auth --project demo-kasir",
    "seed": "node scripts/seed.mjs",
    "set-admin": "node scripts/set-admin.mjs",
    "new-client": "node scripts/new-client.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "firebase-admin": "^14.5.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.8",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true
  }
}
